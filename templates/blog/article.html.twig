<div class="list-group list-group-flush w-100">
    <div class="list-group-item fs-4 text-uppercase text-bg-dark blur-dark">{{ article.title }}</div>
</div>

    {% if article.featuredImageVisible and not article.contentVisible %}
    <div class="p-3 my-auto">
        <div class="row g-3">
            {% if article.gallery %}
            <div class="col-6">
                <img src="{{ asset(article.gallery.images.0.fileUrl)|imagine_filter('sample_image') }}" class="img-fluid img-thumbnail" alt="{{ article.title }}" style="max-height: 800px">
            </div>
            <div class="col-6">
                <img src="{{ asset(article.gallery.images.1.fileUrl)|imagine_filter('sample_image') }}" class="img-fluid img-thumbnail" alt="{{ article.title }}" style="max-height: 800px">
            </div>
            {% else %}
                {% if article.isLandscape %}
                    <div class="col-12">
                        <img src="{{ asset(article.featuredImageUrl)|imagine_filter('h_image') }}" class="img-fluid img-thumbnail" alt="{{ article.title }}" style="max-height: 800px">
                    </div>
                {% else %}
                    <div class="col-12">
                        <img src="{{ asset(article.featuredImageUrl)|imagine_filter('sample_image') }}" class="img-fluid img-thumbnail" alt="{{ article.title }}" style="max-height: 800px">
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </div>
    {% endif %}


        {% if article.contentVisible %}
            <div class="article-wrapper my-auto without-image d-flex align-items-start justify-content-start">
            {% if article.featuredImageVisible %}
                <div class="content-filler h-100"></div>
                <div class="content-image">
                    <img src="{{ asset(article.featuredImageUrl)|imagine_filter('sample_image') }}" class="img-fluid" alt="{{ article.title }}" style="max-height: 1000px">
                </div>
            {% else %}
                <div class="content-filler h-100"></div>
                <div class="content-image image-svg d-flex align-items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="400" height="400"  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon img-fluid icon-tabler icons-tabler-outline icon-tabler-info-circle" style="max-height: 600px">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" />
                        <path d="M12 9h.01" />
                        <path d="M11 12h1v4h1" />
                    </svg>
                </div>
            {% endif %}
                <div class="fs-4 content p-5 w-100 h-100">
                    {{ article.content|raw }}
                </div>
            </div>
        {% endif %}

