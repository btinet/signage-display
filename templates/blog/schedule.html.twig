{% for course, entries in courseEntries %}
    {% set sub_loop = loop.index0 %}
    {# batch(8) teilt die Einträge automatisch in Gruppen von maximal 8 auf #}
    {% for chunk in entries|batch(7) %}
        {# Das "active" wird nur beim allerersten Element aller Schleifen gesetzt #}
        <div class="carousel-item slide-horizontal h-100 {{ main_loop is defined and main_loop == 0 and sub_loop == 0 ? 'active' : '' }}" data-bs-interval="{{ article.duration ?? 10 }}000">

            {# Header (Datum) - nur beim ersten Chunk pro Klasse, oder immer?
               Ich lasse ihn hier immer drin, wie in deinem Code #}
            <div class="list-group-item fs-4 text-uppercase text-bg-dark blur-dark px-3 py-2">
                {% if article.scheduleDate %}
                    Änderungen für den {{ article.scheduleDate|date('d.m.Y') }}
                {% elseif "now"|date('w') == 5 %}
                    Änderungen für <b>Montag</b>
                {% else %}
                    Änderungen für <b>{{ "+ 1 day"|date('w')|trans }}</b>
                {% endif %}
            </div>

            {# Spaltenüberschriften #}
            <div class="list-group-item border-0 border-bottom border-dark small text-bg-tertiary px-3 py-2">
                <div class="row g-1">
                    <div class="col-3 text-uppercase fw-bold fs-6">Stunde</div>
                    <div class="col-5 text-uppercase fw-bold fs-6">Fach</div>
                    <div class="col-4 text-uppercase fw-bold fs-6 text-end">Raum</div>
                    <div class="col-3 text-uppercase">Typ</div>
                    <div class="col-9 text-uppercase">Änderungen</div>
                </div>
            </div>

            {# Klassen-Header #}
            <div class="list-group-item border-0 px-3 py-2 border-bottom border-dark fw-bold fs-5 text-bg-primary text-uppercase text-warning">
                <span class="text-white">Klasse</span> {{ course }}
            </div>

            {# Die eigentlichen Einträge (max 8 pro Seite) #}
            {% set i = 1 %}
            {% set last_color = null %}
            {% for entry in chunk %}
                {% if last_color == entry.scheduleType.color %}
                    {% set i = i+1 %}
                {% else %}
                    {% set i = 1 %}
                {% endif %}
                {% if i % 2 == 0  %}
                    {% set color_b = entry.scheduleType.color ~ "15"  %}
                {% else %}
                    {% set color_b = entry.scheduleType.color ~ "30"  %}
                {% endif %}
                <div class="list-group-item px-3 py-2 border-0 border-bottom border-dark small text-bg-primary" style="
                        background-color: {{ color_b ~ "!important" }};
                        ">
                    <div class="row g-1">
                        <div class="col-3 text-uppercase fw-bold fs-6">{{ entry.entryTime.name|trans }}</div>
                        <div class="col-5 text-uppercase fw-bold fs-6"><span class="fa fa-fw fa-book me-1"></span>{{ entry.plannedSubject }}</div>
                        <div class="col-4 text-uppercase fw-bold fs-6 text-end"><span class="fa fa-fw fa-location-dot"></span>{{ entry.plannedRoom }}</div>
                        <div class="col-3 text-uppercase" style="color: {{ entry.scheduleType.color ~ "!important" }}">
                            {{ entry.scheduleType }}
                        </div>
                        <div class="col-9 text-uppercase">
                            <span class="fa fa-fw fa-person-chalkboard me-2"></span>{{ entry.plannedTeacher }}
                            {% if entry.updatedTeacher and entry.plannedTeacher != entry.updatedTeacher  %}
                                <span class="fa mx-1 fa-fw fa-angle-double-right"></span>
                                <span class="fw-bold" style="color: {{ entry.scheduleType.color ~ "!important" }}">{{ entry.updatedTeacher }}</span>
                            {% endif %}

                            {% if entry.updatedRoom != null and entry.updatedRoom != entry.plannedRoom %}
                                <span class="fa fa-fw fa-location-dot ms-2 me-1"></span>{{ entry.plannedRoom }}
                                <span class="fa mx-1 fa-fw fa-angle-double-right"></span>
                                <span class="fw-bold" style="color: {{ entry.scheduleType.color ~ "!important" }}">{{ entry.updatedRoom }}</span>
                            {% endif %}

                            {% if entry.updatedSubject != null and entry.plannedSubject != entry.updatedSubject %}
                                <span class="fa fa-fw fa-book ms-2 me-1"></span>{{ entry.plannedSubject }}
                                <span class="fa mx-1 fa-fw fa-angle-double-right"></span>
                                <span class="fw-bold" style="color: {{ entry.scheduleType.color ~ "!important" }}">{{ entry.updatedSubject }}</span>
                            {% endif %}

                            {% if entry.updatedCourse != null and entry.course != entry.updatedCourse %}
                                <span class="fa fa-fw fa-users ms-4 me-1"></span>{{ entry.course }}
                                <span class="fa mx-1 fa-fw fa-angle-double-right"></span>
                                <span class="fw-bold" style="color: {{ entry.scheduleType.color ~ "!important" }}">{{ entry.updatedCourse }}</span>
                            {% endif %}
                        </div>
                        <div class="col-12">
                            {% if entry.message and entry.showComment and not ('Ausfall' in entry.message or 'Entfall' in entry.message) %}
                                <span>{{ entry.message }}</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% set last_color = entry.scheduleType.color %}
            {% endfor %}
        </div>
    {% endfor %}
{% endfor %}