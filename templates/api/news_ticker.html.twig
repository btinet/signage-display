{% for shoutOut in shoutOuts %}
    <div class="carousel-item fs-3  fw-bold p-2 text-center {{ shoutOut.type.cssClass }} {{ loop.index0 ? '' : 'active' }}"
         style="{{ (shoutOut.type.useColor and shoutOut.type.color) ? 'background-color:' ~ shoutOut.type.color ~ '!important;' : '' }}">
        {{ shoutOut.message }}
    </div>
{% endfor %}
